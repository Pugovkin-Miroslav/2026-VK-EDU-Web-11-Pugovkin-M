DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use db instead of 127.0.0.1 in .env.docker.
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=vk_answers
POSTGRES_USER=vk_answers
POSTGRES_PASSWORD=

# The port published on 127.0.0.1 by Docker Compose.
POSTGRES_HOST_PORT=5432
